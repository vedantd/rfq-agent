# NICRRON — get your key from https://nicrron.ai/ (credits: COLUMBIA26 event offer)
NICRRON_API_KEY=YOUR_NICRRON_KEY_HERE
NICRRON_BASE_URL=https://api.nicrron.ai/v1
NICRRON_MODEL=nicrron/auto
NICRRON_TIMEOUT_SECONDS=40

# Client-to-QuotePilot B2B API keys (demo keys; replace before any deployment)
QUOTEPILOT_API_KEYS={"rudco-demo-key":"rudco","partner-demo-key":"partner"}

# Database paths
# RFQ_DB_PATH: SQLite database for tenant-specific RFQ storage and caching
RFQ_DB_PATH=quote_api.sqlite3

# RUDCO_DEMO_DB_PATH: RudCo reference catalog database (99 SKUs, benchmarks, compliance rules, etc.)
# If not set, will look for ./rudco_demo_data/rudco_demo.db relative to the app.py location
RUDCO_DEMO_DB_PATH=./rudco_demo_data/rudco_demo.db

# Optional: Webhook configuration for clarification dispatch
# QUOTEPILOT_WEBHOOK_URL=https://your-integration.example.com/webhooks/quotepilot
# QUOTEPILOT_WEBHOOK_SECRET=your-webhook-signing-secret-here
