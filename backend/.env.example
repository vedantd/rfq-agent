# Copy values into Windows user environment variables (never commit real keys).
# LLM provider: claude | nicrron | openai | rules   (default: claude if ANTHROPIC_API_KEY is set, else rules)
LLM_PROVIDER=rules
# Claude (official Anthropic SDK)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Nicrron (OpenAI-compatible gateway, promo code COLUMBIA26)
NICRRON_API_KEY=
NICRRON_MODEL=anthropic/claude-sonnet-5
# Block Convey PRISM tracing
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_PROJECT_ID=
PRISMTRACE_API_KEY=
